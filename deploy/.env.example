# The participant's gRPC Ledger API.
SETTLEMENT_LEDGER_URL=https://ledger-grpc.example.com:443
# OIDC client credentials for the ledger user that acts as the executor
# (and, with the demo on, as the demo traders). Or SETTLEMENT_LEDGER_TOKEN.
SETTLEMENT_OIDC_TOKEN_URL=https://keycloak.example.com/realms/canton/protocol/openid-connect/token
SETTLEMENT_OIDC_CLIENT_ID=
SETTLEMENT_OIDC_CLIENT_SECRET=
# SETTLEMENT_OIDC_AUDIENCE=
# The token-standard registry (for Amulet: a Scan URL).
SETTLEMENT_REGISTRY_URL=https://scan.example.com
# The party that settles: every allocation must name it as executor.
SETTLEMENT_EXECUTOR_PARTY=
# Bearer key for POST /v1/settlements. Unset = read-only API.
SETTLEMENT_API_KEY=
# SETTLEMENT_RECONCILE_SECS=30
# SETTLEMENT_DEFAULT_TTL_SECS=3600

# Demo traders: two parties that open a small DvP with each other on a timer.
# SETTLEMENT_DEMO_TRADER_A=
# SETTLEMENT_DEMO_TRADER_B=
# SETTLEMENT_DEMO_INSTRUMENT=Amulet
# SETTLEMENT_DEMO_AMOUNT_A=0.1
# SETTLEMENT_DEMO_AMOUNT_B=0.05
# SETTLEMENT_DEMO_EVERY_SECS=900
